# Copy to .env to override. Every value here is also the default baked into
# docker-compose.yml, so `docker compose up` works without a .env file.

# PostgreSQL + PostGIS
POSTGRES_DB=vayora
POSTGRES_USER=vayora
POSTGRES_PASSWORD=vayora
POSTGRES_PORT=5432
# The Docker volume holding the database. One made before the project was called VAYORA
# is journex_pgdata; name it here to keep it.
PG_VOLUME=vayora_pgdata

# MongoDB
MONGO_DB=vayora
MONGO_PORT=27017

# Redis
REDIS_PORT=6379

# OSRM — clipped corridor extract (see infra/osrm/prepare.sh)
OSRM_PORT=5000
OSRM_PBF_URL=https://download.geofabrik.de/asia/india/western-zone-latest.osm.pbf
# west,south,east,north — covers Kolhapur to Pune with room for detours
OSRM_BBOX=73.4,16.4,74.9,18.9

# Services
CORE_API_PORT=8080
INTEL_PORT=8000
GATEWAY_PORT=3000
WEB_PORT=5173

# Browser origins allowed to call core-api, comma-separated. Change with WEB_PORT.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# An administrator created when core-api starts. Leave ADMIN_EMAIL empty to have none.
# The password must be at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Shared HS256 secret: core-api signs; the gateway, and intel for live what-if runs,
# verify. Change outside local dev. Must be at least 32 bytes; core-api refuses to start
# with a shorter one.
JWT_SECRET=dev-only-change-me-dev-only-change-me

# Outside services. Each is off while empty, and the app says it is simulated.
# Never commit a .env with real values.
#
# Google sign-in: a Web application OAuth client ID, with http://localhost:5173 as an
# authorised JavaScript origin. Not a secret.
GOOGLE_CLIENT_ID=
# Real text messages and masked calls through Twilio: all three or none. TWILIO_FROM must
# be a Twilio number that can text and call. Twilio's test credentials with
# TWILIO_FROM=+15005550006 are answered as if sent and send nothing.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Payments through Razorpay: both keys or neither. A key starting rzp_test_ is Razorpay's
# test mode, where no real money moves; the app and every receipt say so.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
